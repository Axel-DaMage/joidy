[Unit]
Description=Joidy Docker Services
After=docker.service
Requires=docker.service

# Edit the paths below to match your Joidy checkout location, then:
#   cp joidy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now joidy

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Documents/Repos/Joidy
ExecStart=/bin/bash %h/Documents/Repos/Joidy/scripts/joidy_startup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
