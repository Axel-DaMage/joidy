[Unit]
Description=Joidy Docker Services
After=docker.service
Requires=docker.service

# The Joidy install path is read from /etc/joidy/path (written by the AUR
# package). If the file is missing, the
# fallback below assumes a git checkout at ~/joidy — edit it to match your
# setup, then:
#   cp joidy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now joidy

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'dir=$(cat /etc/joidy/path 2>/dev/null || echo "%h/joidy"); cd "$dir" && exec "$dir/scripts/joidy_startup.sh"'
StandardOutput=journal
StandardError=journal

# ── Baseline sandboxing (#1327) ───────────────────────────────────────
# This is a `systemd --user` unit: the namespace options below implicitly
# enable PrivateUsers= and need unprivileged user namespaces
# (kernel.unprivileged_userns_clone=1 — the default on most distros).
NoNewPrivileges=yes
PrivateTmp=yes
# Mount the whole filesystem read-only except the paths allow-listed in
# ReadWritePaths= (the "-" prefix silently skips paths that don't exist
# instead of failing namespace setup). The CLI writes: the checkout dir
# (.env + data/, e.g. the ~/joidy fallback below), ~/.config/joidy (env
# file on read-only installs), the XDG data dir (data/, backups/, idle/
# state), docker/podman client state and rootless podman storage. If your
# checkout or JOIDY_DATA_DIR lives outside the listed paths, add it here.
ProtectSystem=strict
ReadWritePaths=-%h/joidy -%h/.config/joidy -%h/.local/share/joidy -%h/.docker
ReadWritePaths=-%h/.config/containers -%h/.local/share/containers -%h/.cache/containers
ReadWritePaths=-%t/containers -%t/podman
# Home and /run/user stay READABLE — ~/.config/joidy/path, the .env file
# and the Obsidian vault (OBSIDIAN_VAULT_PATH) are read from there — but
# writable only via the allow-list above.
ProtectHome=read-only
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelModules=yes
# AF_UNIX: engine socket + journal. AF_INET/AF_INET6: API health checks.
# AF_NETLINK: iproute2 (`ss`, `ip`, `hostname -I`) used by the port
# checks and LAN-IP detection in scripts/joidy.sh — without it `ss` fails
# silently and busy ports would appear free.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Only bash and the docker/podman clients run — no JIT needs W+X pages.
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
