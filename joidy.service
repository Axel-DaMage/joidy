[Unit]
Description=Joidy Docker Services
After=docker.service
Requires=docker.service

# The Joidy install path is read from /etc/joidy/path (written by the AUR
# package). If the file is missing, the
# fallback below assumes a git checkout at ~/joidy — edit it to match your
# setup, then:
#   cp joidy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now joidy

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'dir=$(cat /etc/joidy/path 2>/dev/null || echo "%h/joidy"); cd "$dir" && exec "$dir/scripts/joidy_startup.sh"'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
