    "@testing-library/svelte": "^5.4.2",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.2.0",
    "@types/highlight.js": "^10.1.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
