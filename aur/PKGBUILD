# Maintainer: Joidy App <https://github.com/Axel-DaMage/joidy>
# shellcheck shell=bash
pkgname=joidy
pkgver=1.1.0_beta.7
_tag=${pkgver//_/-}
pkgrel=1
pkgdesc="Personal knowledge management with gamification"
arch=('any')
url="https://joidy-web.vercel.app"
license=('GPL-3.0-or-later')
depends=('docker')
install=joidy.install
source=("https://github.com/Axel-DaMage/joidy/archive/v${_tag}.tar.gz"
        "joidy.install")
# Real checksums (#1296, #1394): injected by the release pipeline
# (.github/workflows/release.yml) after the tag is pushed and re-verified by
# aur-publish.yml at publish time. A tagged PKGBUILD can only ever ship SKIP
# for its own tarball (the artifact does not exist until the tag exists).
# Keep this on ONE line: the pipeline rewrites it with `s|^sha256sums=(.*|`.
sha256sums=('c77dee045f15f1ef2ed37d5946c9620e45da4eb54b19b6643739ba6e8b628a70' '1e450ad23eb90939a47e1c3e9c97e19fc20f41293843744bfc61ccedb67d049c')

package() {
  cd "${srcdir}/joidy-${_tag}"
  install -Dm755 scripts/joidy.sh "${pkgdir}/usr/bin/joidy"
  install -Dm644 docker-compose.yml "${pkgdir}/usr/share/joidy/docker-compose.yml"
  # Release-pinned image tags overlay (#1394): opt-in reproducible installs via
  # `docker compose -f docker-compose.yml -f docker-compose.release.yml up -d`.
  install -Dm644 docker-compose.release.yml "${pkgdir}/usr/share/joidy/docker-compose.release.yml"
  # Opt-in overlay for power management (#1278); `joidy up` adds it only when
  # POWER_MANAGEMENT_ENABLED=true.
  install -Dm644 docker-compose.power.yml "${pkgdir}/usr/share/joidy/docker-compose.power.yml"
  install -Dm644 .env.example "${pkgdir}/usr/share/joidy/.env.example"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # Backup sidecar scripts — docker-compose.yml bind-mounts ./scripts read-only
  # into the `backup` service.
  install -Dm755 scripts/db_backup.sh "${pkgdir}/usr/share/joidy/scripts/db_backup.sh"
  install -Dm755 scripts/db_backup_loop.sh "${pkgdir}/usr/share/joidy/scripts/db_backup_loop.sh"
  # Autostart (#1480): systemd user unit + startup script. The unit resolves
  # the install dir via /etc/joidy/path and execs <dir>/scripts/joidy_startup.sh,
  # which in turn runs "joidy.sh up" from the same scripts dir — so a copy of
  # the CLI must live alongside it (in addition to /usr/bin/joidy on PATH).
  install -Dm755 scripts/joidy.sh "${pkgdir}/usr/share/joidy/scripts/joidy.sh"
  install -Dm755 scripts/joidy_startup.sh "${pkgdir}/usr/share/joidy/scripts/joidy_startup.sh"
  install -Dm644 joidy.service "${pkgdir}/usr/lib/systemd/user/joidy.service"
  install -Dm644 /dev/stdin "${pkgdir}/etc/joidy/path" <<<"/usr/share/joidy"
}
